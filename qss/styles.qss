/*
Font families downloaded from https://fonts.google.com/
  Chango
  - Title size 40px weight 400 (regular)
  Nunito
  - Heading size 32px weight 700 (bold)
  - Regular size 24px weight 400 (regular)
  - Caption size 20px weight 300 (light)

Color pallete generated from https://coolors.co/261c15-533f4a-44744a-cbdd7e-e4e6c3-f7f7f2/
COLORS Dictionary from app_theme.py
  "COFFEE_BEAN": "261C15",
  "CREEPER": "533F4A",
  "FERN": "44744A",
  "CREAM": "CBDD7E",
  "BEIGE": "E4E6C3",
  "PORCELIAN": "F7F7F2",
*/

/* Application */

/* General Window Styling */
QMainWindow {
    background-color: {{PORCELIAN}};
    color: {{COFFEE_BEAN}}
    font-family: 
}

/* List Widget Styling */
QListWidget {
    background-color: {{}};
    border: 1px solid {{}};
    border-radius: 8px;
    font-size: 14px;
    padding: 5px;
}

QListWidget::item {
    padding: 10px;
    border-bottom: 1px solid {{}};
}

QListWidget::item:selected {
    background-color: {{}};
    color: #2e7d32;
    border-radius: 4px;
}

/* Input Fields */
QLineEdit, QSpinBox {
    padding: 8px;
    border: 1px solid {{}};
    border-radius: 4px;
    background-color: {{}};
    font-size: 14px;
}

QLineEdit:focus, QSpinBox:focus {
    border: 1px solid {{}};
}

/* Labels */
QLabel {
    font-size: 14px;
    color: {{}};
}

/* Headers */
QLabel#Header {
    font-size: 22px;
    font-weight: bold;
    color: {{}};
}
